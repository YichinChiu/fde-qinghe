  "business_model_usage": [
    {
      "quote": "在测试库中，订单和会员卡均关联 CRM 会员账户，账户与订单、账户与卡分别是一对多关系。",
      "used_for": [
        {
          "kind": "semantic_model",
          "name": "orders"
        },
        {
          "kind": "semantic_model",
          "name": "members"
        }
      ]
    },
    {
      "quote": "订单明确分为线上渠道与门店渠道；谈订单范围时得先说清看的是哪个渠道，不能把两个渠道混在一起看。",
      "used_for": [
        {
          "kind": "semantic_model",
          "name": "orders"
        },
        {
          "kind": "dimension",
          "name": "order__channel"
        }
      ]
    },
    {
      "quote": "小程序订单上的 store_id 具体指下单门店、发货或自提门店还是会员挂靠门店，老周不掌握，待结合实际填写方式和统计说明核实；老周指出不能凭它直接定成交门店数口径。",
      "used_for": [
        {
          "kind": "dimension",
          "name": "store"
        },
        {
          "kind": "metric",
          "name": "order_count"
        },
        {
          "kind": "metric",
          "name": "valid_order_count"
        },
        {
          "kind": "metric",
          "name": "net_sales_cents"
        },
        {
          "kind": "metric",
          "name": "avg_order_value"
        }
      ]
    },
    {
      "quote": "本期注册会员数按等级分组展示，运营同意按“账户当前登记等级”统计，并在回答中注明“按账户当前等级，不是注册当时的等级”；若需要注册当时等级构成，列为数据限制后续处理。",
      "used_for": [
        {
          "kind": "dimension",
          "name": "member__tier"
        }
      ]
    }
  ]
