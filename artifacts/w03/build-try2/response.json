      }
    },
    {
      "id": "net_sales_cents",
      "name": "净销售额",
      "aliases": [],
      "unit": "cents",
      "sources": [
        {
          "file": "01_订单日报说明.md",
          "quote": "paid 订单实付减退款后合计；取消单不计；按原订单下单日期归属；单位分。"
        }
      ],
      "constraints": [
        "按原订单下单日期归属，不是现金退款发生日",
        "取消单不计"
      ],
      "query_policy": {
        "full_month_only": false
      }
    },
    {
      "id": "avg_order_value",
      "name": "有效订单均额",
      "aliases": [],
      "unit": "cents_per_order",
      "sources": [
        {
          "file": "02_财务邮件.md",
          "quote": "净销售额除以有效订单数，单位分／单；分母零时未定义。"
        }
      ],
      "constraints": [
        "分母零时未定义",
        "按原订单下单日期归属"
      ],
      "query_policy": {
        "full_month_only": false
      }
    }
  ],
